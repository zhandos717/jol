# Edge gateway: serves the web apps and routes /api/* to the owning service.
# Services are reached by Docker DNS name; nginx re-resolves them so container restarts don't break routing.
# Template: the nginx image substitutes ${UP_*} from the environment at start, so the full and lite
# profiles share this file and differ only in where each upstream lives.

resolver 127.0.0.11 valid=10s ipv6=off;

limit_req_zone $binary_remote_addr zone=api:10m rate=50r/s;
limit_req_zone $binary_remote_addr zone=orders:10m rate=2r/s;

log_format jol_json escape=json '{"time":"$time_iso8601","request_id":"$request_id","method":"$request_method",'
  '"uri":"$uri","status":$status,"ms":$request_time,"upstream":"$upstream_addr"}';

map $http_x_request_id $req_id {
  default $http_x_request_id;
  ''      $request_id;
}

server {
  listen 80;
  access_log /dev/stdout jol_json;
  client_max_body_size 64k;

  root /usr/share/nginx/html;
  index taxi.html;

  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header X-Request-Id $req_id;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  add_header X-Request-Id $req_id always;

  limit_req_status 429;
  error_page 429 = @too_many;
  error_page 502 503 504 = @unavailable;

  location @too_many    { default_type application/json; return 429 '{"error":"Слишком много запросов, попробуйте через секунду"}'; }
  location @unavailable { default_type application/json; return 503 '{"error":"Сервис временно недоступен"}'; }

  location = /healthz { access_log off; return 200 "ok\n"; }

  location = /api/events {
    set $up http://${UP_REALTIME};
    proxy_pass $up;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  location = /api/orders {
    limit_req zone=orders burst=5 nodelay;
    set $up http://${UP_DISPATCH};
    proxy_pass $up;
  }

  location ~ ^/api/(orders|places)/ { limit_req zone=api burst=100 nodelay; set $up http://${UP_DISPATCH};  proxy_pass $up; }
  location ~ ^/api/(quote|surge)    { limit_req zone=api burst=100 nodelay; set $up http://${UP_PRICING};   proxy_pass $up; }
  location ~ ^/api/drivers?/        { limit_req zone=api burst=200 nodelay; set $up http://${UP_FLEET};     proxy_pass $up; }
  location ~ ^/api/food/            { limit_req zone=api burst=100 nodelay; set $up http://${UP_FOOD};      proxy_pass $up; }
  location ~ ^/api/trips            { limit_req zone=api burst=100 nodelay; set $up http://${UP_INTERCITY}; proxy_pass $up; }
  location = /api/me                { limit_req zone=api burst=100 nodelay; set $up http://${UP_ACCOUNTS};  proxy_pass $up; }

  location /osrm/route/v1/driving/ {
    limit_req zone=api burst=100 nodelay;
    # `set` must precede `rewrite ... break`, which stops the rewrite-module directives after it.
    set $up http://${UP_OSRM};
    rewrite ^/osrm(/.*)$ $1 break;
    proxy_pass $up;
  }

  location /api/ { default_type application/json; return 404 '{"error":"Unknown endpoint"}'; }

  # Revalidate static files by ETag on every load so a deploy is picked up immediately.
  # add_header in a location replaces the server-level ones, hence X-Request-Id is repeated.
  location / {
    add_header Cache-Control "no-cache" always;
    add_header X-Request-Id $req_id always;
    try_files $uri $uri/ =404;
  }
}

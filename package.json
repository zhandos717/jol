{
  "name": "jol",
  "private": true,
  "license": "MIT",
  "description": "Jol — ride-hailing demo for Kazakhstan built as event-driven microservices",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false && echo ok",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc -b --clean"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/pg": "^8.11.10",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
